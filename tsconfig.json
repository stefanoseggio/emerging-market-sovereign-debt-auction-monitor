{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "rootDir": "src",
        "outDir": "dist",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "lib": ["ES2022", "DOM"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "test/**/*"]
}
